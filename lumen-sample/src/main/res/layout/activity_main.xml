<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lumen sample — zero Application glue. Agent starts via ContentProvider."
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Fire 5 HTTP requests" />

    <Button
        android:id="@+id/btn_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Spam logcat" />

    <Button
        android:id="@+id/btn_mock_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request mock target URL" />

    <Button
        android:id="@+id/btn_websocket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open echo WebSocket" />

    <TextView
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#11000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textIsSelectable="true"
        android:textSize="12sp" />

</LinearLayout>
